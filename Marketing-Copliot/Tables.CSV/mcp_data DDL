-- =====================================================
-- 1. USER TABLE
-- =====================================================
CREATE TABLE user_table (
    user_id VARCHAR(10) PRIMARY KEY,           
    user_name VARCHAR(100) NOT NULL,           
    role VARCHAR(50) NOT NULL                  
);

-- =====================================================
-- 2. PRODUCT MASTER TABLE
-- =====================================================
CREATE TABLE product_master_table (
    product_id VARCHAR(10) PRIMARY KEY,        
    product_name VARCHAR(100) NOT NULL,        
    product_category VARCHAR(20) NOT NULL,     
    product_performance TEXT NOT NULL          
);

-- =====================================================
-- 3. HCP MASTER TABLE
-- =====================================================
CREATE TABLE hcp_master_table (
    hcp_id VARCHAR(10) PRIMARY KEY,
product_id VARCHAR(10) NOT NULL,
    user_id VARCHAR(10) NOT NULL,
    hcp_name VARCHAR(100) NOT NULL,
    territory VARCHAR(20) NOT NULL,
    region VARCHAR(20) NOT NULL,
    hcp_state VARCHAR(2) NOT NULL,
    x INTEGER,                  
    y INTEGER,                  
    hcp_state_fullname VARCHAR(100),   
    city VARCHAR(50) NOT NULL,
    specialty VARCHAR(50) NOT NULL,
    sub_specialty VARCHAR(100) NOT NULL,
    hcp_tier CHAR(1) NOT NULL,
    practice_setting VARCHAR(50) NOT NULL,
    years_in_practice INTEGER NOT NULL,
    preferred_channel VARCHAR(20) NOT NULL,
    segment VARCHAR(10) NOT NULL,
    profile_persona VARCHAR(50) NOT NULL,
    relationship_stage VARCHAR(20) NOT NULL,
    adoption_stage INTEGER NOT NULL,
    receptivity_score DECIMAL(5,2) NOT NULL,
    churn_risk_score DECIMAL(4,2) NOT NULL,
FOREIGN KEY (product_id) REFERENCES product_master_table(product_id),
    FOREIGN KEY (user_id) REFERENCES user_table(user_id)
);

-- =====================================================
-- 4. CAMPAIGN MASTER TABLE
-- =====================================================
CREATE TABLE campaign_master_table (
    campaign_id VARCHAR(10) PRIMARY KEY,       
    user_id VARCHAR(10) NOT NULL,             
    hcp_id VARCHAR(10) NOT NULL,              
    campaign_name VARCHAR(100) NOT NULL,     
    channel VARCHAR(20) NOT NULL,              
    start_date DATE NOT NULL,                 
    end_date DATE NOT NULL,                   
    content_type VARCHAR(20) NOT NULL,        
    budget INTEGER NOT NULL,                  
    target_segment VARCHAR(10) NOT NULL,       
    status VARCHAR(20) NOT NULL,              
    
    FOREIGN KEY (user_id) REFERENCES user_table(user_id),
    FOREIGN KEY (hcp_id) REFERENCES hcp_master_table(hcp_id)
);

-- =====================================================
-- 5. CONTENT MASTER TABLE
-- =====================================================
CREATE TABLE content_master_table (
    content_id VARCHAR(10) PRIMARY KEY,       
    campaign_id VARCHAR(10) NOT NULL,         
    content_type VARCHAR(20) NOT NULL,        
    impressions INTEGER NOT NULL,             
    clicks INTEGER NOT NULL,                  
    conversions INTEGER NOT NULL,             
    engagement_rate DECIMAL(4,2) NOT NULL,    
    conversion_rate DECIMAL(4,2) NOT NULL,    
    
    FOREIGN KEY (campaign_id) REFERENCES campaign_master_table(campaign_id)
);

-- =====================================================
-- 6. HCP FEEDBACK TABLE
-- =====================================================
CREATE TABLE hcp_feedback_table (
    hcp_id VARCHAR(10) NOT NULL,              
    product_id VARCHAR(10) NOT NULL,          
    perception_score DECIMAL(3,2) NOT NULL,   
    key_drivers VARCHAR(100) NOT NULL,        
    liked_attributes VARCHAR(100) NOT NULL,   
    
    PRIMARY KEY (hcp_id, product_id),
    FOREIGN KEY (hcp_id) REFERENCES hcp_master_table(hcp_id),
    FOREIGN KEY (product_id) REFERENCES product_master_table(product_id)
);

-- =====================================================
-- 7. HCP INTERACTION TABLE
-- =====================================================
CREATE TABLE hcp_interaction_table (
    interaction_id SERIAL PRIMARY KEY,         
    hcp_id VARCHAR(10) NOT NULL,             
    interaction_date DATE NOT NULL,           
    interaction_type VARCHAR(20) NOT NULL,    
    interaction_channel VARCHAR(20) NOT NULL,  
    last_interaction_channel VARCHAR(20) NOT NULL,
    opened_moa_email_flag VARCHAR(3) NOT NULL, 
    clicked_kol_video_flag VARCHAR(3) NOT NULL,
    clicked_campaign_link_flag VARCHAR(3) NOT NULL, 
    preferred_meeting_time_window VARCHAR(20) NOT NULL, 
    top_recent_objection VARCHAR(20) NOT NULL, 
    last_call_notes_summary TEXT NOT NULL,     
    engaged_interactions DECIMAL(4,2) NOT NULL, 
    
    FOREIGN KEY (hcp_id) REFERENCES hcp_master_table(hcp_id)
);

-- =====================================================
-- 8. CAMPAIGN PERFORMANCE TABLE
-- =====================================================
CREATE TABLE campaign_performance_table (
    performance_id SERIAL PRIMARY KEY,         
    campaign_id VARCHAR(10) NOT NULL,          
    hcp_id VARCHAR(10) NOT NULL,            
    start_date DATE NOT NULL,             
    end_date DATE NOT NULL,                  
    reach DECIMAL(4,2) NOT NULL,              
    engagement_rate DECIMAL(4,2) NOT NULL,     
    conversion_rate DECIMAL(4,2) NOT NULL,     
    downloads INTEGER NOT NULL,                
    impressions INTEGER NOT NULL,             
    clicks INTEGER NOT NULL,                  
    conversions INTEGER NOT NULL,              
    roi DECIMAL(4,2) NOT NULL,              
    month_key INTEGER NOT NULL,              
    quarter_key VARCHAR(2) NOT NULL,          
    year_key INTEGER NOT NULL,                 
    engaged_interactions INTEGER NOT NULL,     
    total_interactions INTEGER NOT NULL,     
    engagement_date DATE NOT NULL,            
    engagement_type VARCHAR(20) NOT NULL,    
    time_spent_minutes DECIMAL(5,1) NOT NULL, 
    
    FOREIGN KEY (campaign_id) REFERENCES campaign_master_table(campaign_id),
    FOREIGN KEY (hcp_id) REFERENCES hcp_master_table(hcp_id)
);