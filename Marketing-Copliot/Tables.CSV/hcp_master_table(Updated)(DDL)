CREATE TABLE hcp_master_table (
    hcp_id VARCHAR(10) PRIMARY KEY,
product_id VARCHAR(10) NOT NULL,
    user_id VARCHAR(10) NOT NULL,
    hcp_name VARCHAR(100) NOT NULL,
    territory VARCHAR(20) NOT NULL,
    region VARCHAR(20) NOT NULL,
    hcp_state VARCHAR(2) NOT NULL,
    x INTEGER,                  
    y INTEGER,                  
    hcp_state_fullname VARCHAR(100),   
    city VARCHAR(50) NOT NULL,
    specialty VARCHAR(50) NOT NULL,
    sub_specialty VARCHAR(100) NOT NULL,
    hcp_tier CHAR(1) NOT NULL,
    practice_setting VARCHAR(50) NOT NULL,
    years_in_practice INTEGER NOT NULL,
    preferred_channel VARCHAR(20) NOT NULL,
    segment VARCHAR(10) NOT NULL,
    profile_persona VARCHAR(50) NOT NULL,
    relationship_stage VARCHAR(20) NOT NULL,
    adoption_stage INTEGER NOT NULL,
    receptivity_score DECIMAL(5,2) NOT NULL,
    churn_risk_score DECIMAL(4,2) NOT NULL,
FOREIGN KEY (product_id) REFERENCES product_master_table(product_id),
    FOREIGN KEY (user_id) REFERENCES user_table(user_id)
);